# ============================================================
# FISHER CCTV PLATFORM — CONFIGURATION TEMPLATE
# Copy this file to finals/.env and fill in your actual credentials.
# NEVER commit real credentials or .env files to GitHub.
# ============================================================

# ------------------------------------------------------------
# 1. Telegram Bot Integration
# ------------------------------------------------------------
BOT_TOKEN=your_telegram_bot_token_here
CHAT_ID=your_telegram_chat_id_here

# ------------------------------------------------------------
# 2. MongoDB Atlas Cloud Database
# ------------------------------------------------------------
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/?retryWrites=true&w=majority
DB_NAME=fisher_cctv

# ------------------------------------------------------------
# 3. Detection & Recording Configuration
# ------------------------------------------------------------
# Video duration in seconds (120 seconds = exactly 2 minutes)
INTRUSION_VIDEO_SECONDS=120

# Exactly three authorized user emails permitted in the system
AUTHORIZED_EMAILS=admin@fisher.cctv,operator@fisher.cctv,supervisor@fisher.cctv

# ------------------------------------------------------------
# 4. Service Host & Port Endpoints
# ------------------------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
API_BASE_URL=http://127.0.0.1:8000
API_DETECTIONS_URL=http://127.0.0.1:8000/api/detections
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# ------------------------------------------------------------
# 5. Frontend Dashboard Environment (fisher-dashboard/.../.env)
# ------------------------------------------------------------
VITE_API_BASE_URL=/api
VITE_BACKEND_URL=http://127.0.0.1:8000
