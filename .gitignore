# ============================================================
# FISHER CCTV — .gitignore Configuration
# ============================================================

# 1. Real Credentials, Environment Files & Secrets (CRITICAL)
.env
.env.*
*.env
!*.env.example
finals/.env
finals/.env.*
fisher-dashboard/**/.env
fisher-dashboard/**/.env.*

# 2. Generated Intrusion Images, Videos, and Media (CRITICAL)
output/
**/output/
finals/output/alerts/*
!finals/output/alerts/.gitkeep
finals/output/intrusions/*
!finals/output/intrusions/.gitkeep
*.mp4
*.avi
*.mkv
*.mov
*.h264
finals/video_animal.mp4
finals/output/intrusions/*.jpg
finals/output/intrusions/*.png
finals/output/intrusions/*.json
finals/output/intrusions/*.mp4

# 3. Node & Frontend Build Artifacts
node_modules/
**/node_modules/
dist/
**/dist/
dist-ssr/
*.local

# 4. Python Bytecode, Caches & Virtual Environments
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/

# 5. Testing & Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log
.coverage
htmlcov/
.pytest_cache/
.vitest/

# 6. Operating System Artifacts
.DS_Store
Thumbs.db
desktop.ini

# 7. IDE & Editor Workspace Settings
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
